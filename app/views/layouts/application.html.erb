<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="description" content="<%= page_description %>">
    <% if @noindex %>
    <meta name="robots" content="noindex, nofollow">
    <% else %>
    <link rel="canonical" href="<%= canonical_url %>">
    <% end %>
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Hampton Lab">
    <meta property="og:locale" content="en_US">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:image" content="https://hamptonlab.com/thumbnail.png">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Hampton Lab">

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <meta name="twitter:image" content="https://hamptonlab.com/thumbnail.png">
    <meta name="twitter:image:alt" content="Hampton Lab">

    <!-- Structured data -->
    <%= json_ld_tag({ "@context" => "https://schema.org", "@graph" => [ organization_json_ld, website_json_ld, founder_json_ld ] }) %>

    <!-- Fav -->
    <link rel="icon" href="/logo-favicon-black.png" type="image/png" media="(prefers-color-scheme: light)">
    <link rel="icon" href="/logo-favicon-black.svg" type="image/svg+xml" media="(prefers-color-scheme: light)">
    <link rel="icon" href="/logo-favicon-white.png" type="image/png" media="(prefers-color-scheme: dark)">
    <!-- <link rel="icon" href="/logo-favicon-white.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)"> -->
    <link rel="apple-touch-icon" href="/logo-favicon-black.png" media="(prefers-color-scheme: light)">
    <!-- <link rel="apple-touch-icon" href="/logo-favicon-black.png" media="(prefers-color-scheme: dark)"> -->

    <%# Fonts used above the fold on every page; fetch them in parallel with the CSS. %>
    <link rel="preload" href="<%= asset_path("PPEiko-Medium.woff2") %>" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="<%= asset_path("Basis-Grotesque-Pro-Regular.woff2") %>" as="font" type="font/woff2" crossorigin>

    <%# All stylesheet files in app/assets/stylesheets (actiontext.css only on blog pages) %>
    <%= stylesheet_link_tag *page_stylesheets, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= javascript_import_module_tag "@hotwired/turbo-rails" if admin_page? %>
    <%= javascript_import_module_tag "rich_text" if rich_text_page? %>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LFDRL0V51F"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LFDRL0V51F');
    </script>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
