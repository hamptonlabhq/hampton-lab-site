<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Hampton Lab" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="title" content="Hampton Lab: A Website Design and Mangement Company.">
    <meta name="description" content="We design, develop, and manage beautiful websites for $50/mo.">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://hamptonlab.com">
    <meta property="og:title" content="Hampton Lab: A Website Design and Mangement Company.">
    <meta property="og:description" content="We design, develop, and manage beautiful websites for $50/mo.">
    <meta property="og:image" content="https://hamptonlab.com/thumbnail.png">

    <!-- Fav -->
    <link rel="icon" href="/logo-favicon-black.png" type="image/png" media="(prefers-color-scheme: light)">
    <link rel="icon" href="/logo-favicon-black.svg" type="image/svg+xml" media="(prefers-color-scheme: light)">
    <link rel="icon" href="/logo-favicon-white.png" type="image/png" media="(prefers-color-scheme: dark)">
    <!-- <link rel="icon" href="/logo-favicon-white.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)"> -->
    <link rel="apple-touch-icon" href="/logo-favicon-black.png" media="(prefers-color-scheme: light)">
    <!-- <link rel="apple-touch-icon" href="/logo-favicon-black.png" media="(prefers-color-scheme: dark)"> -->

    <%# Fonts used above the fold on every page; fetch them in parallel with the CSS. %>
    <link rel="preload" href="<%= asset_path("PPEiko-Medium.woff2") %>" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="<%= asset_path("Basis-Grotesque-Pro-Regular.woff2") %>" as="font" type="font/woff2" crossorigin>

    <%# All stylesheet files in app/assets/stylesheets (actiontext.css only on blog pages) %>
    <%= stylesheet_link_tag *page_stylesheets, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= javascript_import_module_tag "rich_text" if rich_text_page? %>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LFDRL0V51F"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LFDRL0V51F');
    </script>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
